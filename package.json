{
  "name": "ashniva-ads",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --project unit --project web && pnpm --filter @ashniva/connectors test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @ashniva/db generate",
    "db:migrate": "pnpm --filter @ashniva/db migrate",
    "db:deploy": "pnpm --filter @ashniva/db run deploy",
    "db:seed": "pnpm --filter @ashniva/core seed",
    "db:studio": "pnpm --filter @ashniva/db studio",
    "localdb:start": "pg_ctl -D .data/postgres status >/dev/null 2>&1 && echo 'Database is already running.' || pg_ctl -D .data/postgres -l .data/postgres.log start",
    "localdb:stop": "pg_ctl -D .data/postgres stop",
    "test:unit": "vitest run --project unit",
    "test:web": "vitest run --project web",
    "test:integration": "vitest run --project integration",
    "test:connectors": "pnpm --filter @ashniva/connectors test",
    "test:all": "pnpm test && pnpm test:integration",
    "test:coverage": "vitest run --coverage --project unit --project integration --project web"
  },
  "devDependencies": {
    "@ashniva/api": "workspace:*",
    "@ashniva/connectors": "workspace:*",
    "@ashniva/core": "workspace:*",
    "@ashniva/db": "workspace:*",
    "@ashniva/shared": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "30.1.3",
    "jsonwebtoken": "^9.0.3",
    "msw": "3.0.3",
    "pg": "^8.16.0",
    "supertest": "7.3.1",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "vitest": "4.1.12"
  }
}
