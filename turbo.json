{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalDependencies": [
    ".env"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^generate"
      ]
    },
    "generate": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL"
      ]
    },
    "build": {
      "dependsOn": [
        "^generate",
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "API_URL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^generate"
      ]
    },
    "lint": {}
  }
}
