# ───────── Production (docker-compose.yml) ─────────
# Only used by docker compose on your server; see DEPLOY.md.
# DOMAIN=ads.yourcompany.com
# POSTGRES_USER=ashniva
# POSTGRES_PASSWORD=change-me-long-random
# POSTGRES_DB=ashniva_ads

# ───────── Core ─────────
NODE_ENV=development
WEB_URL=http://localhost:3100
API_URL=http://localhost:4100
API_PORT=4100

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/ashniva_ads
REDIS_URL=redis://127.0.0.1:6379

# ───────── Security ─────────
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OAUTH_STATE_SECRET=
# 32-byte key (64 hex chars) used to encrypt platform OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=

# ───────── Email (optional: logs to console when empty) ─────────
# Invitations, password reset links, alerts and reports. Use SMTP (any mail
# server) or Resend. EMAIL_PROVIDER: SMTP | RESEND (empty = whichever is set).
EMAIL_PROVIDER=
SMTP_HOST=
# 587 = STARTTLS, 465 = SSL
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM="Ashniva Ads <no-reply@ashniva.com>"

# ───────── Integration keys ─────────
# The ad platform, Razorpay and AI keys below (and the email settings above) can also be
# set in the app: sign in as a super admin → Admin → API keys & integrations.
# Values saved there are encrypted with TOKEN_ENCRYPTION_KEY and take priority over
# this file, so you can leave these empty.

# ───────── Meta Marketing API ─────────
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v26.0

# ───────── Google Ads API (also covers YouTube) ─────────
# OAuth client from the Cloud project where the Google Ads API is enabled.
# Access level (Test, Explorer, Basic) is set on that project's API overview page.
# Developer tokens were sunset on 9 Sep 2026; leave GOOGLE_ADS_DEVELOPER_TOKEN empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25

# ───────── Sync ─────────
# How often active connections are re-synced, in minutes
SYNC_INTERVAL_MINUTES=180
# Days of history fetched on the first sync
INITIAL_SYNC_DAYS=1095

# ───────── More ad platforms ─────────
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202609
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_DEVELOPER_TOKEN=
MICROSOFT_TENANT=common
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Login with Amazon app (advertising::campaign_management). Redirect: {WEB_URL}/api/oauth/amazon/callback
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# X Ads API OAuth 2 app. Redirect: {WEB_URL}/api/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# Apple Search Ads API. Paste the client secret Apple gives you (or the signed JWT).
APPLE_ADS_CLIENT_ID=
APPLE_ADS_CLIENT_SECRET=
# Spotify Ads API partner app. Redirect: {WEB_URL}/api/oauth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Criteo Marketing API app (client credentials).
CRITEO_CLIENT_ID=
CRITEO_CLIENT_SECRET=
# Taboola Backstage API app (client credentials).
TABOOLA_CLIENT_ID=
TABOOLA_CLIENT_SECRET=
# Outbrain Amplify API token from Amplify → Settings. No OAuth redirect.
OUTBRAIN_API_TOKEN=
# The Trade Desk partner API token and partner id. No OAuth redirect.
TRADEDESK_API_TOKEN=
TRADEDESK_PARTNER_ID=
# Yahoo DSP OAuth app. Redirect: {WEB_URL}/api/oauth/yahoo/callback
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Shopify app from the Dev Dashboard. Redirect: {WEB_URL}/api/oauth/shopify/callback
# The store domain is entered on Connect, not here.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ───────── File storage (creatives, logos) ─────────
# Local folder used when S3_BUCKET is empty (relative to this file)
UPLOAD_DIR=.data/uploads
# S3-compatible storage for production (AWS S3, Cloudflare R2, DO Spaces…)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for stored files, e.g. your CDN. Defaults to /api/files
FILES_PUBLIC_URL=

# ───────── Billing (Razorpay subscriptions) ─────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: existing Razorpay plan ids. When empty (or the price changed), plans are
# created automatically from the prices set in Admin → Plans & pricing.
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_AGENCY=

# ───────── AI assistant (platform-provided, metered in tokens) ─────────
# One key for the whole platform. Organizations get AI_FREE_TOKENS free, then buy token packs.
# Free tokens, token packs, plan prices and the trial length are set in Admin → Plans & pricing.
# AI_PROVIDER: GEMINI | OPENAI | ANTHROPIC | OPENAI_COMPATIBLE
AI_PROVIDER=GEMINI
AI_API_KEY=
# Defaults: gemini-3.8-flash · gpt-6.1-sol · claude-sonnet-5-5
AI_MODEL=
# Only for OPENAI_COMPATIBLE, e.g. https://openrouter.ai/api/v1 or https://api.groq.com/openai/v1
AI_BASE_URL=
AI_FREE_TOKENS=100000

# ───────── Platform admin ─────────
# Comma-separated emails with access to /admin
SUPER_ADMIN_EMAILS=

# ───────── Ashniva Central Control (Theme Studio live theme) ─────────
CENTRAL_CONTROL_ENABLE_SDK=false
CENTRAL_CONTROL_URL=http://localhost:4500
CENTRAL_CONTROL_PRODUCT_SLUG=marketing
CENTRAL_CONTROL_ENVIRONMENT=development
CENTRAL_CONTROL_INSTALLATION_ID=
CENTRAL_CONTROL_SERVER_SECRET=
CENTRAL_CONTROL_CONNECTOR_VERSION=1.0.0
CENTRAL_CONTROL_HEARTBEAT_INTERVAL_MS=30000
